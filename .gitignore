# ─────────────────────────────────────────────────────────────────────────────
# TETROBOT — git ignore
# Covers the whole repo (root tooling, apps/ desktop app, firmware/, tools/)
# ─────────────────────────────────────────────────────────────────────────────

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
jspm_packages/

# ── Build output / bundles ───────────────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo

# ── Electron packaged installers / app bundles ───────────────────────────────
release/
release-builds/
studio/release/
# Wildcard, not just "release/": an electron-builder run that output to release2/ slipped
# past the exact-name rules and committed 72 build files including a 266MB app.asar, which
# GitHub rejects (100MB/file limit). Any release* output directory is build product.
release*/
studio/release*/
# app.asar is the packaged app bundle — always build output, always too big for git.
*.asar
*.exe
*.dmg
*.AppImage
*.deb
*.snap
*.blockmap
# electron-builder cache
.electron-builder/
electron-builder.env

# ── Logs & caches ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.cache/
*.local

# ── Python (backend / tooling) ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Editors / IDEs ───────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── ESP32 / PlatformIO / Arduino build artifacts ─────────────────────────────
# Wildcards, not exact names: the rules used to say only "esp32/", so esp32_v2/build/
# was never ignored and was one accidental `git add -A` away from being committed —
# the same exact-name gap that let a 266MB release2/ build into a commit.
esp32*/.pio/
esp32*/build/
firmware/**/build/
firmware/**/.pio/
*.bin
*.elf
*.map

# ── Local dev scratch ────────────────────────────────────────────────────────
# These were previously COMMITTED. A source repo should hold source; scratch files,
# sample projects and captured output are local artefacts.
/verify*.js
/test_*.mjs
/screenshot_*.png
/home_*.png
/playwright_*.js
/*.nischay
.scratch*/

# ── Vendored build dependencies ──────────────────────────────────────────────
# zenoh-c is fetched/built, not authored here, so it does not belong in git history.
.build-deps/

# Rust RT Core build artifacts
rtcore/target/

# Firmware sketch — kept local, not on GitHub (per request)
esp32/firmware.ino

# Claude Code agent worktrees: never commit (a gitlink here breaks actions/checkout cleanup)
.claude/worktrees/

# ── Simulation data: only what the software needs goes to git (see data/README.md) ──
data/**
!data/README.md
!data/logs/
!data/logs/shapes*.json
!data/logs/grown_shapes.json
!data/logs/tf_*.json
!data/logs/transform_run_*.json
!data/runs/
!data/runs/dock_v3/
!data/runs/dock_v3/brain.npz
!data/logs/bridge_cands.json
!data/logs/chain_scenes.json
!data/logs/grow_cands.json
!data/logs/grown_shapes.json
!data/logs/judge_scene.json
!data/logs/reach2.csv
!data/logs/reach_end.csv
!data/logs/reach_lying.csv
!data/logs/shapes.json
!data/logs/shapes_ok.json
!data/logs/shapes_v1.json
!data/logs/target_stiffness.csv
!data/runs/dock_ikrl/brain.npz
!data/runs/dock_v3/brain.npz
!data/runs/dock_ikrl/

# ROS 2 installed by pixi (big, on this computer only); ros2/pixi.toml and pixi.lock say what is installed
ros2/.pixi/
