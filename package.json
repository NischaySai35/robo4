{
  "name": "tetrobot",
  "version": "1.0.3",
  "private": true,
  "description": "TETROBOT \u2014 modular robotics design, simulation and control platform. The desktop app lives in apps/studio; firmware in firmware/; docs in docs/.",
  "author": "Nischay Sai D R",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/NischaySai35/robo4.git"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "npm run dev --prefix apps/studio",
    "build": "npm run build --prefix apps/studio",
    "typecheck": "npm run typecheck --prefix apps/studio",
    "electron:dev": "npm run electron:dev --prefix apps/studio",
    "depcruise": "cd apps/studio && depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --ignore-known",
    "depcruise:all": "cd apps/studio && depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --no-ignore-known --output-type err-long",
    "depcruise:baseline": "cd apps/studio && depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --output-type baseline > .dependency-cruiser-known-violations.json",
    "test": "npm run test --prefix apps/studio"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.4",
    "playwright": "^1.60.0"
  }
}
