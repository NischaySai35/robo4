{
  "name": "robo4-simulator",
  "version": "1.0.4",
  "private": true,
  "description": "TETROBOT - GUI-first modular robotics modeling and simulation platform",
  "author": "Nischay Sai <nischaysai35@gmail.com>",
  "homepage": "https://github.com/NischaySai35/robo4",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "node electron/launch.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && node electron/launch.cjs\"",
    "electron:build": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "dist": "vite build && electron-builder --dir",
    "icons": "node scripts/make-icons.cjs",
    "postinstall": "node scripts/fix-pathtracer.cjs",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "depcruise": "depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --ignore-known",
    "depcruise:all": "depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --no-ignore-known --output-type err-long",
    "depcruise:baseline": "depcruise --config .dependency-cruiser.cjs \"src/**/*.ts\" \"src/**/*.tsx\" --output-type baseline > .dependency-cruiser-known-violations.json"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.2",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.6",
    "dependency-cruiser": "^18.7.0",
    "dockview-react": "^8.8.3",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jolt-physics": "^1.1.1",
    "lucide-react": "^1.66.0",
    "occt-import-js": "^0.0.23",
    "onnxruntime-web": "^1.31.1",
    "png-to-ico": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "three-gpu-pathtracer": "^0.0.27",
    "three-mesh-bvh": "^0.9.17",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "uplot": "^1.6.32",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1",
    "xatlas-web": "^0.1.0",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.nischaysai.tetrobot",
    "productName": "TETROBOT-Demo-NischaySai",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/gpuWatcher.cjs",
      "tools/psStream.cjs"
    ],
    "directories": {
      "output": "release2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NischaySai35",
        "repo": "robo4"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "category": "Development",
      "synopsis": "Modular robot modeling and simulation"
    },
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "TETROBOT",
      "runAfterFinish": true,
      "shortcutName": "TETROBOT-Demo-NischaySai",
      "artifactName": "TETROBOT-Demo-NischaySai-Setup-${version}.${ext}",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "uninstallDisplayName": "TETROBOT-Demo-NischaySai",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "sharp@0.35.5": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.31.1": true,
    "protobufjs@7.6.6": true
  },
  "overrides": {
    "@electron/asar": "^4.3.1",
    "global-agent": "^4.1.6",
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "onnxruntime-web": "$onnxruntime-web",
    "rimraf": "^6.1.3",
    "@types/node": "$@types/node",
    "onnxruntime-node": "1.31.1",
    "@electron/get": "^5.1.0"
  }
}
