{
  "name": "robo4-simulator",
  "version": "1.0.4",
  "private": true,
  "description": "TETROBOT - GUI-first modular robotics modeling and simulation platform",
  "author": "Nischay Sai <nischaysai35@gmail.com>",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron": "node electron/launch.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && node electron/launch.cjs\"",
    "electron:build": "vite build && electron-builder",
    "release": "vite build && electron-builder --publish always",
    "dist": "vite build && electron-builder --dir",
    "icons": "node scripts/make-icons.cjs",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@huggingface/transformers": "^4.3.1",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "electron-updater": "^6.8.9",
    "jolt-physics": "^1.0.1",
    "occt-import-js": "^0.0.23",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "postprocessing": "6.36.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.164.1",
    "three-gpu-pathtracer": "^0.0.24",
    "three-mesh-bvh": "^0.9.10",
    "uplot": "^1.6.32",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.1.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.35.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.nischaysai.tetrobot",
    "productName": "TETROBOT-Demo-NischaySai",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "tools/gpuWatcher.cjs",
      "tools/psStream.cjs"
    ],
    "directories": {
      "output": "release2"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NischaySai35",
        "repo": "robo4"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "menuCategory": "TETROBOT",
      "runAfterFinish": true,
      "shortcutName": "TETROBOT-Demo-NischaySai",
      "artifactName": "TETROBOT-Demo-NischaySai-Setup-${version}.${ext}",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico",
      "uninstallDisplayName": "TETROBOT-Demo-NischaySai",
      "deleteAppDataOnUninstall": false
    }
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "electron@33.4.11": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.21.0": true,
    "protobufjs@7.6.4": true
  },
  "overrides": {
    "sprintf-js": "^1.1.3"
  }
}
